    "react-native-vision-camera": "^5",
    "react-query": "^3.39.3",
    "timeago.js": "^4.0.2"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "modulePathIgnorePatterns": [
      "<rootDir>/storybook/",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "packageManager": "pnpm@10.5.2",
  "pnpm": {
    "patchedDependencies": {
      "react-native": "patches/react-native.patch",
      "react-native-web": "patches/react-native-web.patch",
      "react-native-builder-bob": "patches/react-native-builder-bob.patch"
    }
  }
}
